# Core manager settings
HONEYPOT_DB_PATH=data/honeypot.db
HONEYPOT_DEFAULT_BIND=127.0.0.1
HONEYPOT_DASHBOARD_HOST=127.0.0.1
HONEYPOT_DASHBOARD_PORT=8088

# Optional threat-intel enrichment
# Leave disabled unless you intentionally want to enrich activity with HIBP data.
ENABLE_HIBP_ENRICHMENT=false
HIBP_API_KEY=
HIBP_USER_AGENT=deception-honeypot-manager/1.0 (+https://example.invalid)

